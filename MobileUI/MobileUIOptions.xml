<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

    <Frame name="MobileUIOptionsPanel" parent="UIParent" hidden="true">
        <Scripts>
            <OnLoad>
                self.name = "MobileUI"
                InterfaceOptions_AddCategory(self)
            </OnLoad>
            <OnShow function="MobileUI_OptionsOnShow"/>
        </Scripts>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormalLarge" text="MobileUI">
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset><AbsDimension x="16" y="-16"/></Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
                <FontString name="$parentSubTitle" inherits="GameFontHighlightSmall"
                            text="Fixed 1.2x UI scale, minimap 1.25x. Mobile-tuned for Ascension WoW.">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentTitle" relativePoint="BOTTOMLEFT">
                            <Offset><AbsDimension x="0" y="-8"/></Offset>
                        </Anchor>
                    </Anchors>
                    <Size><AbsDimension x="320" y="30"/></Size>
                </FontString>
            </Layer>
        </Layers>

        <Frames>
            <Slider name="$parentLookSpeedSlider" inherits="OptionsSliderTemplate">
                <Size><AbsDimension x="240" y="16"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentSubTitle" relativePoint="BOTTOMLEFT">
                        <Offset><AbsDimension x="0" y="-20"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        _G[self:GetName().."Text"]:SetText("Mouse Look Speed")
                        _G[self:GetName().."High"]:SetText("90")
                        _G[self:GetName().."Low"]:SetText("10")
                        self:SetMinMaxValues(10, 90)
                        self:SetValueStep(5)
                    </OnLoad>
                    <OnValueChanged>
                        MobileUI_OptionsOnLookSpeedChanged(self:GetValue())
                    </OnValueChanged>
                </Scripts>
            </Slider>

            <CheckButton name="$parentLayoutCheck" inherits="OptionsCheckButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentLookSpeedSlider" relativePoint="BOTTOMLEFT">
                        <Offset><AbsDimension x="0" y="-24"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        _G[self:GetName().."Text"]:SetText("Mobile Layout Revamp")
                    </OnLoad>
                    <OnClick>
                        MobileUI_OptionsOnLayoutChanged(self:GetChecked())
                    </OnClick>
                </Scripts>
            </CheckButton>

            <CheckButton name="$parentDebugCheck" inherits="OptionsCheckButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentLayoutCheck" relativePoint="BOTTOMLEFT">
                        <Offset><AbsDimension x="0" y="-8"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        _G[self:GetName().."Text"]:SetText("Debug to Chat")
                    </OnLoad>
                    <OnClick>
                        MobileUI_OptionsOnDebugChanged(self:GetChecked())
                    </OnClick>
                </Scripts>
            </CheckButton>

            <CheckButton name="$parentFlipLiteCheck" inherits="OptionsCheckButtonTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" relativeTo="$parentDebugCheck" relativePoint="BOTTOMLEFT">
                        <Offset><AbsDimension x="0" y="-8"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnLoad>
                        _G[self:GetName().."Text"]:SetText("Flip Lite (experimental)")
                    </OnLoad>
                    <OnClick>
                        MobileUI_OptionsOnFlipLiteChanged(self:GetChecked())
                    </OnClick>
                </Scripts>
            </CheckButton>
        </Frames>
    </Frame>

</Ui>